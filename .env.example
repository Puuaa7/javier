# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# URL del proyecto (Project Settings → API). No es secreta.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (sb_secret_…) o, en proyectos antiguos, la service_role key.
# SOLO servidor: no le pongas el prefijo NEXT_PUBLIC_ o acabaría en el navegador.
SUPABASE_SECRET_KEY=

# Opcional. Clave de MapTiler (https://cloud.maptiler.com/account/keys/) para el
# mapa base "Dataviz". Es pública por diseño: restríngela a tus dominios en
# MapTiler. Sin ella el mapa usa OpenFreeMap.
# NEXT_PUBLIC_MAPTILER_KEY=

# Necesaria para publicar (p. ej. en Vercel): contraseña que pide toda la
# aplicación (HTTP Basic, cualquier usuario). Sin ella, los endpoints
# /api/supabase/* se desactivan en producción. En local puede quedar vacía.
# ETL_PASSWORD=

# Desaconsejado: abre /api/supabase/* en producción SIN contraseña.
# ETL_PERMITIR_EN_PRODUCCION=false
